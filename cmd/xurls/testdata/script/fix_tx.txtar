# Fixing multiple files is transactional: every url in every file is checked
# first, and no file is modified unless all of them can be fixed and written.

expand one.md
cp one.md one.orig
expand two.md
cp two.md two.orig
expand bad.md
cp bad.md bad.orig

# Listing the same file twice is a usage error; nothing is checked or written.
! exec xurls -fix one.md one.md
! stdout .
stderr 'file listed twice: one.md'
cmp one.md one.orig

# Mixing standard input and files is a usage error too.
! exec xurls -fix one.md -
stderr 'cannot mix standard input and files'

# A broken url in any file rolls back the whole transaction:
# no file is modified, and the manifest records the error.
! exec xurls -fix -fix-manifest=badmanifest.json one.md bad.md
! stdout .
stderr -count=1 'found 1 broken urls in "bad.md"'
stderr -count=1 '/404 - 404 Not Found'
cmp one.md one.orig
cmp two.md two.orig
cmp bad.md bad.orig
expand badmanifest.golden
cmp badmanifest.json badmanifest.golden

# A successful run fixes all files and lists them in argument order,
# and the manifest records the final url of every match.
exec xurls -fix -fix-manifest=manifest.json two.md one.md
stdout '^two.md$'
stdout '^one.md$'
! stderr .
expand two.golden
cmp two.md two.golden
expand one.golden
cmp one.md one.golden
expand manifest.golden
cmp manifest.json manifest.golden

# A successful rerun is idempotent: no changes, no output, exit code zero,
# and the manifest records that every url is already final.
exec xurls -fix -fix-manifest=manifest2.json two.md one.md
! stdout .
! stderr .
cmp two.md two.golden
cmp one.md one.golden
expand manifest2.golden
cmp manifest2.json manifest2.golden

-- one.md --
First ${SERVER}/redir-1 then ${SERVER}/get-only end
-- one.golden --
First ${SERVER}/plain-head then ${SERVER}/plain-get end
-- two.md --
Second ${SERVER}/redir-2
-- two.golden --
Second ${SERVER}/plain-head
-- bad.md --
Broken ${SERVER}/404 link
-- manifest.golden --
[
  {
    "file": "two.md",
    "line": 1,
    "url": "${SERVER}/redir-2",
    "final": "${SERVER}/plain-head"
  },
  {
    "file": "one.md",
    "line": 1,
    "url": "${SERVER}/redir-1",
    "final": "${SERVER}/plain-head"
  },
  {
    "file": "one.md",
    "line": 1,
    "url": "${SERVER}/get-only",
    "final": "${SERVER}/plain-get"
  }
]
-- manifest2.golden --
[
  {
    "file": "two.md",
    "line": 1,
    "url": "${SERVER}/plain-head",
    "final": "${SERVER}/plain-head"
  },
  {
    "file": "one.md",
    "line": 1,
    "url": "${SERVER}/plain-head",
    "final": "${SERVER}/plain-head"
  },
  {
    "file": "one.md",
    "line": 1,
    "url": "${SERVER}/plain-get",
    "final": "${SERVER}/plain-get"
  }
]
-- badmanifest.golden --
[
  {
    "file": "one.md",
    "line": 1,
    "url": "${SERVER}/redir-1",
    "final": "${SERVER}/plain-head"
  },
  {
    "file": "one.md",
    "line": 1,
    "url": "${SERVER}/get-only",
    "final": "${SERVER}/plain-get"
  },
  {
    "file": "bad.md",
    "line": 1,
    "url": "${SERVER}/404",
    "error": "404 Not Found",
    "kind": "http_status"
  }
]
